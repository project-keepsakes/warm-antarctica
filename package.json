{
  "name": "antarctica-connected",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vite preview --host 127.0.0.1 --port 3000",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/og-runtime.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "maplibre-gl": "6.4.1",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "cross-env": "^10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.4",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.4.2",
    "vite": "8.3.5",
    "wrangler": "4.156.1",
    "@cloudflare/workers-types": "5.20261103.1"
  },
  "type": "module",
  "overrides": {
    "esbuild@<0.25.0": "0.25.12",
    "esbuild@>=0.27.3 <0.28.1": "0.28.1",
    "image-size@<2.0.3": "2.0.4",
    "sharp@<0.35.5": "0.35.5",
    "undici@<7.30.1": "7.30.1",
    "ws@<8.21.0": "8.21.0",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    },
    "fflate@>=0.7.0 <0.7.5": "0.7.5"
  }
}
